{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": false,
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ],
  "exclude": [
    "coverage/**",
    "dist/**",
    "out/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "test/**",
    "**/test/**",
    "**/__tests__/**",
    "**/node_modules/**",
    "**/scripts/**",
    "**/docs/**",
    "**/*.js"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "instrument": true,
  "require": [
    "ts-node/register"
  ],
  "sourceMap": true,
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ]
} 